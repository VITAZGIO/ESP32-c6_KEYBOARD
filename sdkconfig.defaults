# Флеш 4 МБ (ESP32-C6 SuperMini), разметка с двумя разделами под OTA
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="ota.csv"

# Zigbee End Device
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZED=y
CONFIG_ZB_RADIO_NATIVE=y

# Криптография для Zigbee
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_ECJPAKE_C=y

# Light sleep — набор из примера Espressif light_sleep для ESP32-C6.
# MAC_BB_PD обязателен: без него после первого сна радио перестаёт передавать.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_IEEE802154_SLEEP_ENABLE=y
CONFIG_ESP_PHY_MAC_BB_PD=y
# Отключение периферии и флеша во сне ВЫКЛЮЧЕНО: с ними C6 просыпался
# ~315 раз в секунду без причины (тест без Zigbee, 2 мс сна подряд).
# Экономили они ~0.1 мА — на фоне 5 мА платы это ничто.
# CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP is not set
# CONFIG_ESP_SLEEP_POWER_DOWN_FLASH is not set
CONFIG_FREERTOS_HZ=1000

# Лог в монитор порта через встроенный USB платы (на SuperMini нет USB-UART чипа).
# UART0 (GPIO16/17) не используем совсем.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Пока USB воткнут — не спать (иначе порт пропадает, лог и заливка рвутся).
# От батареи без USB спит как обычно.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# Откат: если новая прошивка падает при старте, загрузится прежняя
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Диагностика: статистика сна в esp_pm_dump_locks (потом можно выключить)
CONFIG_PM_PROFILING=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
